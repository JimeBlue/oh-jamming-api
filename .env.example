PORT = 8080
MONGODB_URI = Your mongo URI here
CLIENT_URL = http://localhost:3000
# generate with: openssl rand -hex 64
JWT_SECRET = Your jwt secret here
# seconds — how long a refresh token stays valid (default 30 days)
REFRESH_TOKEN_TTL = 2592000
# from the Cloudinary dashboard → API keys. Optional: leave them out and everything works except
# POST /uploads/image, which answers 503
CLOUDINARY_CLOUD_NAME = Your cloud name here
CLOUDINARY_API_KEY = Your api key here
CLOUDINARY_API_SECRET = Your api secret here
# from aistudio.google.com/apikey. Optional: leave it out and everything works except
# POST /ai/overview, which answers 503
GEMINI_API_KEY = Your gemini api key here
